# =========================
# API
# =========================
API_HOST=127.0.0.1
API_PORT=8000

# =========================
# Frontend
# Pentru desktop/local beta poți folosi URL absolut către API.
# Dacă în web build folosești proxy /api, adaptezi după implementarea ta.
# =========================
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000

# =========================
# SQLite
# Adaptează path-ul dacă proiectul tău folosește alt nume / altă locație.
# Exemple:
# DATABASE_URL=sqlite:///./price_watch_ro.db
# DATABASE_URL=sqlite:///./data/app.db
# =========================
DATABASE_URL=sqlite:///./price_watch_ro.db

# =========================
# Chrome remote debugging
# Necesar pentru promo / rendered refresh
# =========================
CHROME_REMOTE_DEBUGGING_PORT=9222

# =========================
# App mode
# Opțional, doar dacă îl folosești deja în proiect
# =========================
APP_ENV=development
