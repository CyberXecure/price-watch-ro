{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chilipir",
  "version": "0.1.0",
  "identifier": "ro.pricewatch.desktop",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../../build/web-export"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Chilipir",
        "width": 1280,
        "height": 900,
        "resizable": true
      }
    ]
